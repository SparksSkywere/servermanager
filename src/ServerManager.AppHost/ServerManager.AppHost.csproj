<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>ServerManager</AssemblyName>
    <Product>Server Manager</Product>
    <Description>Server Manager process supervisor</Description>
    <ApplicationIcon>..\..\icons\servermanager.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServerManager.Core\ServerManager.Core.csproj" />
    <ProjectReference Include="..\ServerManager.Data\ServerManager.Data.csproj" />
    <ProjectReference Include="..\ServerManager.Automation\ServerManager.Automation.csproj" />
  </ItemGroup>
</Project>
